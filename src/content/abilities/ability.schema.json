{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Declarative ability definition",
  "description": "Closed data format for player skills and character mechanics. Runtime code must dispatch only these enumerated primitives.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "sourceKind", "activation", "rules", "tags"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "usage": { "type": "string" },
    "sourceKind": { "enum": ["player-skill", "character-mechanic"] },
    "parameters": { "type": "object", "additionalProperties": { "$ref": "#/definitions/parameter" } },
    "activation": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "windows", "consume"], "properties": { "type": { "const": "action" }, "windows": { "type": "array", "items": { "enum": ["owner-turn", "owner-roulette-reaction"] }, "minItems": 1 }, "consume": { "enum": ["card", "none"] }, "availability": { "type": "array", "items": { "$ref": "#/definitions/condition" } } } },
      { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "automatic" } } },
      { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "passive" } } }
    ] },
    "rules": { "type": "array", "items": { "$ref": "#/definitions/rule" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "unlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opponentId", "label"],
      "properties": {
        "opponentId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "parameter": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "enum": ["number", "boolean", "enum"] }, "minimum": { "type": "number" }, "maximum": { "type": "number" }, "values": { "type": "array", "items": { "type": "string" } }, "default": {} } },
    "rule": { "type": "object", "additionalProperties": false, "required": ["id", "trigger", "effects"], "properties": { "id": { "type": "string" }, "trigger": { "enum": ["on-match-created", "on-ability-played", "before-card-draw", "after-card-draw", "after-hand-changed", "before-round-resolution", "before-bullet-load", "after-bullet-load", "before-trigger-pull", "after-trigger-result", "on-round-end"] }, "priority": { "type": "integer" }, "conditions": { "type": "array", "items": { "$ref": "#/definitions/condition" } }, "effects": { "type": "array", "items": { "$ref": "#/definitions/effect" }, "minItems": 1 }, "limit": { "type": "object", "additionalProperties": false } } },
    "condition": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "actor"], "properties": { "type": { "const": "actor-is" }, "actor": { "$ref": "#/definitions/actor" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "abilityId"], "properties": { "type": { "const": "owner-has-card" }, "abilityId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "operator", "value"], "properties": { "type": { "enum": ["hand-card-count", "hand-total"] }, "target": { "$ref": "#/definitions/actor" }, "operator": { "$ref": "#/definitions/operator" }, "value": { "$ref": "#/definitions/scalar" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "enum": ["hand-all-same-suit", "hand-is-twenty-one"] }, "target": { "$ref": "#/definitions/actor" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "card", "origin"], "properties": { "type": { "const": "hand-card-origin-is" }, "target": { "$ref": "#/definitions/actor" }, "card": { "const": "last-card" }, "origin": { "enum": ["shoe", "derived"] } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "card", "source", "candidate"], "properties": { "type": { "const": "card-candidate-exists" }, "target": { "$ref": "#/definitions/actor" }, "card": { "const": "last-card" }, "source": { "const": "remaining-draw-pile" }, "candidate": { "$ref": "#/definitions/candidate" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "operator", "value"], "properties": { "type": { "const": "gun-bullets" }, "target": { "$ref": "#/definitions/actor" }, "operator": { "$ref": "#/definitions/operator" }, "value": { "$ref": "#/definitions/scalar" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "expected"], "properties": { "type": { "const": "gun-is-full" }, "target": { "$ref": "#/definitions/actor" }, "expected": { "type": "boolean" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "round-reason-is" }, "value": { "enum": ["blackjack", "bust", "comparison", "push"] } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "const": "round-penalty-target-is" }, "target": { "$ref": "#/definitions/actor" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "statusDefinitionId"], "properties": { "type": { "const": "status-present" }, "target": { "$ref": "#/definitions/actor" }, "statusDefinitionId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "conditions"], "properties": { "type": { "const": "any" }, "conditions": { "type": "array", "items": { "$ref": "#/definitions/condition" } } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "condition"], "properties": { "type": { "const": "not" }, "condition": { "$ref": "#/definitions/condition" } } }
    ] },
    "effect": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "amount"], "properties": { "type": { "const": "draw-skill-cards" }, "target": { "$ref": "#/definitions/actor" }, "amount": { "$ref": "#/definitions/scalar" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "policy"], "properties": { "type": { "const": "publish-action-advice" }, "target": { "$ref": "#/definitions/actor" }, "policy": { "const": "current-optimal-hit-stand" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "card", "source", "candidate", "pick"], "properties": { "type": { "const": "replace-hand-card" }, "target": { "$ref": "#/definitions/actor" }, "card": { "const": "last-card" }, "source": { "const": "remaining-draw-pile" }, "candidate": { "$ref": "#/definitions/candidate" }, "pick": { "const": "uniform-ability-rng" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "statusDefinitionId"], "properties": { "type": { "enum": ["add-status", "remove-status"] }, "target": { "$ref": "#/definitions/actor" }, "statusDefinitionId": { "type": "string", "minLength": 1 }, "amount": { "$ref": "#/definitions/scalar" }, "parameters": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "policy"], "properties": { "type": { "const": "replace-pending-draw" }, "target": { "$ref": "#/definitions/actor" }, "policy": { "type": "object", "additionalProperties": false, "required": ["type", "total", "fallback"], "properties": { "type": { "const": "exact-resulting-total" }, "total": { "$ref": "#/definitions/scalar" }, "fallback": { "const": "create-derived-card" } } } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "amount"], "properties": { "type": { "const": "add-to-pending-load" }, "target": { "$ref": "#/definitions/actor" }, "amount": { "$ref": "#/definitions/scalar" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target", "factor"], "properties": { "type": { "const": "multiply-pending-load" }, "target": { "$ref": "#/definitions/actor" }, "factor": { "$ref": "#/definitions/scalar" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "const": "cancel-pending-trigger" }, "target": { "$ref": "#/definitions/actor" } } }
    ] },
    "actor": { "enum": ["owner", "rival", "event-actor", "penalty-target"] },
    "operator": { "enum": ["eq", "neq", "lt", "lte", "gt", "gte"] },
    "scalar": { "oneOf": [ { "type": "number" }, { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "constant" }, "value": { "type": "number" } } }, { "type": "object", "additionalProperties": false, "required": ["type", "key"], "properties": { "type": { "const": "parameter" }, "key": { "type": "string", "minLength": 1 } } }, { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "enum": ["gun-bullets", "hand-total"] }, "target": { "$ref": "#/definitions/actor" } } } ] },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "enum": ["resulting-hand-total-at-most", "resulting-hand-total-exactly"] }, "value": { "$ref": "#/definitions/scalar" } } }
  }
}
