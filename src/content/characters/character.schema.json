{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character.schema.json",
  "title": "古堡魔鬼牌局与会者定义",
  "description": "泰拉与会者的参局档案、结局文案、指定服装资源、AI 参数和互斥对话池标准。角色 JSON 通过顶层 $schema 引用本文件，编辑器会显示这里的中文说明。",
  "$comment": "叙事映射固定为 player=来自高位面的策展人，opponent/AI=回应邀请的与会者，staff=执行轮盘惩罚的发牌员。与会者被实弹命中会当场死亡；策展人受罚时枪口朝向天花板，player-killed 只是兼容性标识，公开结果是与会者赢得一个愿望，隐藏结果是策展人回溯到本局以前重开，且与会者绝不知情。对话解析顺序固定为：轮盘状态 > 本轮结果特殊牌型 > Blackjack/Bust/Comparison/Push > 当前轮最新行动 > MATCH_START。一次渲染只会选择一个池。",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "assets", "profile", "trophyDossier", "matchSummary", "revolverPlacement", "ai", "aiSkills", "dialogue"],
  "properties": {
    "$schema": {
      "const": "../character.schema.json",
      "description": "固定的与会者 JSON Schema 相对路径；不要修改。"
    },
    "assets": {
      "type": "object",
      "description": "该与会者在古堡牌桌、致命轮盘和结局总结使用的图像资源；既有字段名为兼容性代码标识。",
      "additionalProperties": false,
      "required": ["relaxed", "conflicted", "mocking", "threatened", "staffRevolver", "unconscious", "defeatedSummary"],
      "properties": {
        "relaxed": { "$ref": "#/$defs/assetPath", "description": "与会者入席后的普通牌桌立绘。" },
        "conflicted": { "$ref": "#/$defs/assetPath", "description": "与会者权衡手牌和死亡风险时的立绘。" },
        "mocking": { "$ref": "#/$defs/assetPath", "description": "与会者赢得一轮时的立绘。" },
        "threatened": { "$ref": "#/$defs/assetPath", "description": "与会者等待发牌员对准头部扣动扳机时的立绘。" },
        "staffRevolver": { "$ref": "#/$defs/assetPath", "description": "发牌员持有的真实 7mm 左轮叠加图，只用于瞄准受罚与会者。" },
        "unconscious": { "$ref": "#/$defs/assetPath", "description": "兼容性字段名；实际表示与会者被实弹命中、当场死亡后的牌桌立绘，不得解释为昏迷。" },
        "defeatedSummary": { "$ref": "#/$defs/assetPath", "description": "策展人获胜、与会者死亡后的结局总结全身图。" }
      }
    },
    "profile": {
      "type": "object",
      "description": "古堡大厅中的与会者档案，应说明其执念、回应策展人邀请的理由及指定服装背景。",
      "additionalProperties": false,
      "required": ["description"],
      "properties": { "description": { "type": "string", "minLength": 1, "description": "与会者档案正文；不得让与会者知晓策展人的时间回溯能力。" } }
    },
    "trophyDossier": {
      "type": "object",
      "description": "战利品鉴赏页右侧拉出的纸质行政档案；全部可见文案均由角色数据维护。",
      "additionalProperties": false,
      "required": ["title", "recordLabel", "openLabel", "closeLabel", "fields", "condition"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "description": "档案大标题。" },
        "recordLabel": { "type": "string", "minLength": 1, "description": "右上角档案编号。" },
        "openLabel": { "type": "string", "minLength": 1, "description": "抽屉收起时露出的侧边标签。" },
        "closeLabel": { "type": "string", "minLength": 1, "description": "抽屉展开后的侧边标签。" },
        "fields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "description": "按显示顺序填写姓名、种族、性别、评级、重量和处女性；运行时 Schema 会校验六种 ID 各出现一次。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "value"],
            "properties": {
              "id": { "enum": ["name", "race", "gender", "tier", "weight", "virginity"] },
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "description"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "matchSummary": {
      "type": "object",
      "description": "整局结束后的与会者专属结局文案；字段名继续按内部 player 视角解释。",
      "additionalProperties": false,
      "required": ["playerVictory", "playerDefeat", "escaped"],
      "properties": {
        "playerVictory": { "type": "string", "minLength": 1, "description": "策展人获胜，发牌员射杀与会者，最终保留该时间线。" },
        "playerDefeat": { "type": "string", "minLength": 1, "description": "与会者在公开规则下获胜并可许下任意一个愿望；策展人不会死亡，隐藏时间线将被回溯。" },
        "escaped": { "type": "string", "minLength": 1, "description": "策展人中途终止本次古堡牌局。" }
      }
    },
    "infoBar": {
      "type": "object",
      "description": "该与会者绑定的单一牌桌信息栏；数值由技能底座根据当前牌局动态解析。",
      "additionalProperties": false,
      "required": ["sourceAbilityId", "label", "description", "value"],
      "properties": {
        "sourceAbilityId": { "type": "string", "minLength": 1, "description": "必须与该角色 aiSkills 中一个 enabled=true 的 AI Skill definitionId 相同。" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "format": { "enum": ["number", "percent"], "default": "number", "description": "数值显示格式；percent 将 0–1 的小数显示为百分比。" },
        "value": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "number" }, "value": { "$ref": "#/$defs/infoBarScalar" } } },
            { "type": "object", "additionalProperties": false, "required": ["type", "target", "card"], "properties": { "type": { "enum": ["card", "suit"] }, "target": { "$ref": "#/$defs/infoBarActor" }, "card": { "enum": ["last-card", "first-private-card"] } } },
            { "type": "object", "additionalProperties": false, "required": ["type", "source", "statusDefinitionId"], "properties": { "type": { "enum": ["card", "suit"] }, "source": { "const": "status-card" }, "statusDefinitionId": { "type": "string", "minLength": 1 } } }
          ]
        }
      },
      "allOf": [
        {
          "if": { "required": ["format"], "properties": { "format": { "const": "percent" } } },
          "then": { "properties": { "value": { "properties": { "type": { "const": "number" } } } } }
        }
      ]
    },
    "trophyGallery": {
      "type": "object",
      "description": "策展人获胜且与会者死亡后，在历史详情中显示的可选收藏记录；未配置的与会者只显示统计。",
      "additionalProperties": false,
      "required": ["headshot", "fullBody", "closeups"],
      "properties": {
        "headshot": { "$ref": "#/$defs/assetPath", "description": "5:7 的与会者遗体档案头肩像。" },
        "fullBody": { "$ref": "#/$defs/assetPath", "description": "2:3 竖屏透明背景的遗体角色层，与共享棺材底图叠加；同时作为记录点坐标基准。" },
        "poses": {
          "type": "array",
          "minItems": 1,
          "description": "可选的其他陈列姿势；每项都是与共享棺材底图对齐的 2:3 透明角色层，局部记录点不跟随这些姿势显示。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "image"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "与会者内唯一的稳定姿势 ID。" },
              "name": { "type": "string", "minLength": 1, "description": "姿势切换按钮文案。" },
              "image": { "$ref": "#/$defs/assetPath", "description": "2:3 透明背景的角色层。" }
            }
          }
        },
        "closeups": {
          "type": "array",
          "description": "可添加任意数量的方形局部收藏记录；x/y 为相对共享棺材与默认 fullBody 合成画面的百分比坐标。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "x", "y", "image", "description"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "与会者内唯一的稳定记录点 ID。" },
              "name": { "type": "string", "minLength": 1, "description": "面向策展人的记录点名称。" },
              "x": { "type": "number", "minimum": 0, "maximum": 100, "description": "记录点中心相对底图左侧的百分比。" },
              "y": { "type": "number", "minimum": 0, "maximum": 100, "description": "记录点中心相对底图顶部的百分比。" },
              "image": { "$ref": "#/$defs/assetPath", "description": "1:1 方形局部收藏图，固定作为点击记录点后显示的 p0。" },
              "description": { "type": "string", "minLength": 1, "description": "p0 对应的与会者专属说明。" },
              "variants": {
                "type": "array",
                "minItems": 1,
                "description": "可选的 p1、p2……差分；按数组顺序在点击局部立绘时循环。",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["image", "description"],
                  "properties": {
                    "image": { "$ref": "#/$defs/assetPath", "description": "1:1 方形局部差分图。" },
                    "description": { "type": "string", "minLength": 1, "description": "仅对应该差分图的说明。" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "revolverPlacement": {
      "type": "object",
      "description": "发牌员左轮相对受罚与会者立绘的位置，单位为 CSS 像素；策展人朝天花板的枪击不使用这组坐标。",
      "additionalProperties": false,
      "required": ["top", "left", "mobileTop", "mobileLeft"],
      "properties": {
        "top": { "type": "number", "description": "桌面端 top。" },
        "left": { "type": "number", "description": "桌面端 left。" },
        "mobileTop": { "type": "number", "description": "移动端 top。" },
        "mobileLeft": { "type": "number", "description": "移动端 left。" }
      }
    },
    "ai": {
      "type": "object",
      "description": "与会者 AI 阈值参数。T = 16 + P + 0.1 × A × (策展人子弹数 - 与会者子弹数) + B × Rmatch + C × Rplay；总点数小于等于 T 时 Hit。",
      "additionalProperties": false,
      "required": ["P", "A", "B", "C"],
      "properties": {
        "P": { "type": "number", "default": 0, "description": "固定阈值偏移；默认 0。" },
        "A": { "type": "number", "default": 1, "description": "双方子弹差值的权重；默认 1。" },
        "B": { "type": "number", "default": 1, "description": "整局固定噪声 Rmatch 的权重；默认 1。" },
        "C": { "type": "number", "default": 1, "description": "每手重抽噪声 Rplay 的权重；默认 1。" }
      }
    },
    "aiSkills": {
      "type": "array",
      "description": "与会者绑定的声明式能力；只允许 registry 中已验证的 definitionId 和参数。",
      "items": { "$ref": "#/$defs/abilityBinding" }
    },
    "dialogue": {
      "type": "object",
      "description": "与会者的有限状态对话池。每个字段都必填；解析器每次只选择其中一个字段。与会者可以理解公开的许愿回报，但绝不能知晓失败时间线会被策展人回溯。",
      "additionalProperties": false,
      "required": [
        "MATCH_START", "PLAYER_HIT", "PLAYER_STAND",
        "OPPONENT_FIRST_HIT", "OPPONENT_FIRST_STAND", "OPPONENT_REPEAT_HIT_AFTER_PLAYER_STAND",
        "PLAYER_BLACKJACK", "OPPONENT_BLACKJACK", "PLAYER_BUST", "OPPONENT_BUST",
        "PLAYER_SURVIVED_TRIGGER", "OPPONENT_SURVIVED_TRIGGER",
        "PLAYER_WIN_ROUND", "OPPONENT_WIN_ROUND", "PUSH_ROUND",
        "PLAYER_TRIGGER_READY", "OPPONENT_TRIGGER_READY", "PLAYER_TRIGGER_HIT", "OPPONENT_TRIGGER_HIT",
        "SPECIAL_TWENTY_ONE_PUSH", "SPECIAL_LOW_PUSH"
      ],
      "properties": {
        "MATCH_START": { "$ref": "#/$defs/dialoguePool", "description": "本轮尚无行动时；可体现与会者的执念和古堡牌局氛围。" },
        "PLAYER_HIT": { "$ref": "#/$defs/dialoguePool", "description": "当前轮最新有效行动是策展人 Hit。" },
        "PLAYER_STAND": { "$ref": "#/$defs/dialoguePool", "description": "策展人刚刚 Stand，且本轮尚未结算。" },
        "OPPONENT_FIRST_HIT": { "$ref": "#/$defs/dialoguePool", "description": "与会者在当前轮第一次行动选择 Hit。" },
        "OPPONENT_FIRST_STAND": { "$ref": "#/$defs/dialoguePool", "description": "与会者在当前轮第一次行动选择 Stand，且没有立即结算。" },
        "OPPONENT_REPEAT_HIT_AFTER_PLAYER_STAND": { "$ref": "#/$defs/dialoguePool", "description": "策展人已 Stand，与会者在当前轮完成第一次 Hit 后进行第二次或更多次 Hit。" },
        "PLAYER_BLACKJACK": { "$ref": "#/$defs/dialoguePool", "description": "仅 reason=blackjack 且策展人独有 Blackjack；不会落入 PLAYER_WIN_ROUND。" },
        "OPPONENT_BLACKJACK": { "$ref": "#/$defs/dialoguePool", "description": "仅 reason=blackjack 且与会者独有 Blackjack；不会落入 OPPONENT_WIN_ROUND。" },
        "PLAYER_BUST": { "$ref": "#/$defs/dialoguePool", "description": "仅策展人爆牌。" },
        "OPPONENT_BUST": { "$ref": "#/$defs/dialoguePool", "description": "仅与会者爆牌。" },
        "PLAYER_SURVIVED_TRIGGER": { "$ref": "#/$defs/dialoguePool", "description": "策展人朝天花板扣下扳机但未击发。" },
        "OPPONENT_SURVIVED_TRIGGER": { "$ref": "#/$defs/dialoguePool", "description": "发牌员对准与会者头部扣下扳机但未击发。" },
        "PLAYER_WIN_ROUND": { "$ref": "#/$defs/dialoguePool", "description": "仅普通点数比较由策展人获胜；不含 Blackjack、爆牌和特殊牌型。" },
        "OPPONENT_WIN_ROUND": { "$ref": "#/$defs/dialoguePool", "description": "仅普通点数比较由与会者获胜；不含 Blackjack、爆牌和特殊牌型。" },
        "PUSH_ROUND": { "$ref": "#/$defs/dialoguePool", "description": "不属于特殊 21 对 21 或低点数平局的普通平局。" },
        "PLAYER_TRIGGER_READY": { "$ref": "#/$defs/dialoguePool", "description": "策展人受罚，确认结果后等待执行朝向天花板的轮盘扳机。" },
        "OPPONENT_TRIGGER_READY": { "$ref": "#/$defs/dialoguePool", "description": "与会者受罚，确认结果后等待发牌员对其执行轮盘扳机。" },
        "PLAYER_TRIGGER_HIT": { "$ref": "#/$defs/dialoguePool", "description": "策展人的左轮朝天花板击发；策展人不死，公开结果为与会者赢得愿望，隐藏时间线随后回溯。" },
        "OPPONENT_TRIGGER_HIT": { "$ref": "#/$defs/dialoguePool", "description": "发牌员对准与会者头部击发实弹，与会者当场死亡。" },
        "SPECIAL_TWENTY_ONE_PUSH": { "$ref": "#/$defs/dialoguePool", "description": "双方都是 21；优先于其他 21 类特殊牌型。" },
        "SPECIAL_LOW_PUSH": { "$ref": "#/$defs/dialoguePool", "description": "双方以相同的 12 至 16 点形成低点数平局。" }
      }
    }
  },
  "$defs": {
    "infoBarActor": { "enum": ["owner", "rival"] },
    "infoBarScalar": {
      "oneOf": [
        { "type": "number" },
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "constant" }, "value": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "enum": ["gun-bullets", "hand-total", "hand-card-count", "round-hit-count"] }, "target": { "$ref": "#/$defs/infoBarActor" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "target", "statusDefinitionId"], "properties": { "type": { "const": "status-stacks" }, "target": { "$ref": "#/$defs/infoBarActor" }, "statusDefinitionId": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "left", "right"], "properties": { "type": { "enum": ["add", "subtract", "multiply", "min", "max"] }, "left": { "$ref": "#/$defs/infoBarScalar" }, "right": { "$ref": "#/$defs/infoBarScalar" } } }
      ]
    },
    "assetPath": { "type": "string", "minLength": 1, "pattern": "^/assets/" },
    "dialoguePool": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "abilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionId", "enabled", "parameters"],
      "properties": {
        "definitionId": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "parameters": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    }
  }
}
